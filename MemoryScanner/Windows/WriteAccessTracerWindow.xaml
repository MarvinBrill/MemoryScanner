<Window x:Class="MemoryScanner.Windows.WriteAccessTracerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find Out What Writes/Accesses This Address" Height="760" Width="1380" MinHeight="560" MinWidth="1080" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Target Address" VerticalAlignment="Center"/>
            <TextBox x:Name="TargetAddressText" Grid.Column="1" Margin="6,0,12,0" VerticalContentAlignment="Center" IsReadOnly="True"/>

            <TextBlock Grid.Column="2" Text="Data Type" VerticalAlignment="Center"/>
            <ComboBox x:Name="DataTypeBox" Grid.Column="3" Margin="6,0,12,0" VerticalContentAlignment="Center"/>

            <TextBlock Grid.Column="4" Text="Interval (ms)" VerticalAlignment="Center"/>
            <TextBox x:Name="IntervalMsText" Grid.Column="5" Margin="6,0,12,0" VerticalContentAlignment="Center" Text="20"/>

            <TextBlock Grid.Column="6" Text="Max Rows" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxRowsText" Grid.Column="7" Margin="6,0,12,0" VerticalContentAlignment="Center" Text="500"/>

            <TextBlock Grid.Column="8" Text="Max Cand Offset" VerticalAlignment="Center"/>
            <TextBox x:Name="MaxCandidateOffsetText" Grid.Column="9" Margin="6,0,12,0" VerticalContentAlignment="Center" Text="0x10000"/>

            <Button Grid.Column="10" x:Name="StartButton" Content="Start" Width="90" Height="30" Margin="0,0,8,0" Click="Start_OnClick"/>
            <Button Grid.Column="11" x:Name="StopButton" Content="Stop" Width="90" Height="30" Margin="0,0,8,0" Click="Stop_OnClick" IsEnabled="False"/>
            <Button Grid.Column="12" Content="Clear" Width="90" Height="30" HorizontalAlignment="Left" Click="Clear_OnClick"/>
        </Grid>

        <Border Grid.Row="1" Background="#FFF6F6F6" BorderBrush="#FFD6D6D6" BorderThickness="1" Padding="8" Margin="0,0,0,8">
            <TextBlock x:Name="HelpText" TextWrapping="Wrap" Foreground="#FF333333"
                       Text="Workflow: (1) Start monitor, (2) trigger the in-game action that changes this value, (3) pick instruction rows with high Hits and plausible Base Candidate + small Offset, (4) open pointer scan from candidate base; if no base exists, use instruction-context button."/>
        </Border>

        <TextBlock Grid.Row="2" x:Name="StatusText" Margin="0,0,0,8" Foreground="#FF444444" Text="Idle"/>

        <DataGrid x:Name="TraceGrid"
                  Grid.Row="3"
                  AutoGenerateColumns="False"
                  SelectionMode="Single"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding TimeText}" Width="0.9*"/>
                <DataGridTextColumn Header="Old" Binding="{Binding OldValueText}" Width="0.8*"/>
                <DataGridTextColumn Header="New" Binding="{Binding NewValueText}" Width="0.8*"/>
                <DataGridTextColumn Header="TID" Binding="{Binding ThreadId}" Width="0.6*"/>
                <DataGridTextColumn Header="Instruction" Binding="{Binding InstructionText}" Width="2.0*"/>
                <DataGridTextColumn Header="Hits" Binding="{Binding InstructionHits}" Width="0.6*"/>
                <DataGridTextColumn Header="Base Candidate" Binding="{Binding BaseCandidateText}" Width="1.6*"/>
                <DataGridTextColumn Header="Offset" Binding="{Binding OffsetText}" Width="0.8*"/>
                <DataGridTextColumn Header="Candidate Address" Binding="{Binding CandidateAddressText}" Width="1.3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Open Pointer Scanner For Candidate Base" Width="270" Height="30" Margin="0,0,8,0" Click="OpenPointerScanner_OnClick"/>
            <Button Content="Open Pointer Scanner (Instruction Context)" Width="290" Height="30" Margin="0,0,8,0" Click="OpenPointerScannerFromInstruction_OnClick"/>
            <Button Content="Copy Selected Row" Width="140" Height="30" Margin="0,0,8,0" Click="CopySelected_OnClick"/>
            <Button Content="Close" Width="90" Height="30" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
