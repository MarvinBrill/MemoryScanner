<Window x:Class="MemoryScanner.Windows.PointerLoadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading Pointer Session"
        Height="170"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="ToolWindow">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StageText"
                   Grid.Row="0"
                   Foreground="Black"
                   FontWeight="SemiBold"
                   Text="Preparing load..."/>

        <ProgressBar x:Name="LoadProgressBar"
                     Grid.Row="1"
                     Margin="0,10,0,8"
                     Height="20"
                     Minimum="0"
                     Maximum="100"
                     Value="0"/>

        <TextBlock x:Name="DetailText"
                   Grid.Row="2"
                   Foreground="Black"
                   TextWrapping="Wrap"
                   Text="Starting..."/>
    </Grid>
</Window>
