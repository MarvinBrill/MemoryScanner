<Window x:Class="MemoryScanner.Windows.PointerSaveOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pointer Save Options" Height="300" Width="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Save/Compression Settings" FontWeight="SemiBold" Margin="0,0,0,10"/>

            <CheckBox x:Name="EnableCompressionBox"
                      Content="Enable GZip compression (smaller files, recommended)"
                      Margin="0,0,0,8"
                      Checked="EnableCompressionBox_OnChanged"
                      Unchecked="EnableCompressionBox_OnChanged"/>

            <CheckBox x:Name="CompactJsonBox"
                      Content="Compact JSON (no indentation)"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="UseCompactSchemaBox"
                      Content="Use compact save schema (omit cached display text)"
                      Margin="0,0,0,8"/>

            <Border Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
                <TextBlock x:Name="InfoText"
                           TextWrapping="Wrap"
                           Foreground="#FF333333"
                           Text="Output: .json.gz (auto) when compression is enabled. Files stay loadable in MemoryScanner."/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="100" Height="30" Margin="0,0,8,0" Click="Cancel_OnClick"/>
            <Button Content="Apply" Width="100" Height="30" Click="Apply_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
