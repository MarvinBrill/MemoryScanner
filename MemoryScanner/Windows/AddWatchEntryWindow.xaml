<Window x:Class="MemoryScanner.Windows.AddWatchEntryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Address / Pointer" Height="430" Width="560" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Mode" Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModeBox" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8" SelectionChanged="ModeBox_OnSelectionChanged">
                <ComboBoxItem Content="Direct Address"/>
                <ComboBoxItem Content="Pointer Chain"/>
            </ComboBox>

            <TextBlock x:Name="NameLabel" Text="Name" Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
            <TextBox x:Name="NameText" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock x:Name="DataTypeLabel" Text="Data Type" Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
            <ComboBox x:Name="DataTypeBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock x:Name="AddressLabel" Text="Address" Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center"/>
            <TextBox x:Name="AddressText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" TextChanged="AddressText_OnTextChanged"/>

            <TextBlock x:Name="ResolvedPointerBaseLabel" Text="Resolved Base Address" Grid.Row="4" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox x:Name="ResolvedPointerBaseText" Grid.Row="4" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed" IsReadOnly="True"/>

            <TextBlock x:Name="ModuleNameLabel" Text="Base Module Name (internal)" Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox x:Name="ModuleNameText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed" IsReadOnly="True"/>

            <TextBlock x:Name="ModuleOffsetLabel" Text="Base Module Offset (internal)" Grid.Row="6" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox x:Name="ModuleOffsetText" Grid.Row="6" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed" IsReadOnly="True"/>

            <TextBlock x:Name="OffsetsLabel" Text="Offsets (comma separated)" Grid.Row="7" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Visibility="Collapsed"/>
            <TextBox x:Name="OffsetsText" Grid.Row="7" Grid.Column="1" Margin="0,0,0,8" Visibility="Collapsed"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="100" Height="30" Margin="0,0,8,0" Click="Cancel_OnClick"/>
            <Button x:Name="ConfirmButton" Content="Add" Width="100" Height="30" Click="Add_OnClick"/>
        </StackPanel>
    </Grid>
</Window>
