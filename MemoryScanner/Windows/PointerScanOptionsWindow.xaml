<Window x:Class="MemoryScanner.Windows.PointerScanOptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pointer Scan Options" Height="430" Width="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Max Depth"/>
            <TextBox x:Name="MaxDepthText" Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Max Offset"/>
            <ComboBox x:Name="MaxOffsetBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" IsEditable="True">
                <ComboBoxItem Content="1024"/>
                <ComboBoxItem Content="2048"/>
                <ComboBoxItem Content="4096"/>
                <ComboBoxItem Content="8192"/>
                <ComboBoxItem Content="16384"/>
                <ComboBoxItem Content="32768"/>
                <ComboBoxItem Content="65536"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Alignment"/>
            <ComboBox x:Name="AlignmentBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                <ComboBoxItem Content="4"/>
                <ComboBoxItem Content="8"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Thread Count"/>
            <TextBox x:Name="ThreadCountText" Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"/>

            <CheckBox x:Name="UseResultLimitBox" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,2,0,8" Content="Use result limit" Checked="UseResultLimitBox_OnChanged" Unchecked="UseResultLimitBox_OnChanged"/>

            <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Result Limit"/>
            <TextBox x:Name="ResultLimitText" Grid.Row="5" Grid.Column="1" Margin="0,0,0,8"/>

            <CheckBox x:Name="IncludePrivateBox" Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="Include Private"/>
            <CheckBox x:Name="IncludeMappedBox" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="Include Mapped"/>
            <CheckBox x:Name="IncludeImageBox" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="Include Image/Module"/>
            <CheckBox x:Name="RequireStaticRootBox" Grid.Row="9" Grid.ColumnSpan="2" Margin="0,0,0,8" Content="Only Process+Base results (static roots)"/>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="100" Height="30" Margin="0,0,8,0" Click="Cancel_OnClick"/>
            <Button Content="Apply" Width="100" Height="30" Click="Apply_OnClick"/>
        </StackPanel>
    </Grid>
</Window>


