<Window x:Class="MemoryScanner.Windows.PatternScannerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Pattern Scanner"
        Height="760"
        Width="1240"
        MinHeight="620"
        MinWidth="980"
        WindowStartupLocation="CenterOwner">
    <Grid Background="#FF1E1E1E" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FF2B2B2B" Margin="0,0,0,8">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
                <Style x:Key="TopLevelMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Foreground" Value="#FFF0F0F0"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="_Load..." Click="MenuLoadPattern_OnClick"/>
                <Separator/>
                <MenuItem Header="_Save" Click="MenuSavePattern_OnClick"/>
                <MenuItem Header="Save _As..." Click="MenuSavePatternAs_OnClick"/>
            </MenuItem>
        </Menu>

        <TextBlock Grid.Row="1"
                   Text="Address Pattern Scanner"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="#FFF0F0F0"
                   Margin="0,0,0,8"/>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Start Data Type" Foreground="#FFE6E6E6"/>
                <ComboBox x:Name="StartDataTypeBox"
                          Margin="0,4,0,0"
                          Height="28"
                          SelectionChanged="StartDataTypeBox_OnSelectionChanged"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Start Value" Foreground="#FFE6E6E6"/>
                <TextBox x:Name="StartValueText"
                         Margin="0,4,0,0"
                         Height="28"
                         VerticalContentAlignment="Center"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Margin="0,0,8,0">
                <TextBlock Text="Step Size (bytes)" Foreground="#FFE6E6E6"/>
                <TextBox x:Name="StepSizeText"
                         Margin="0,4,0,0"
                         Height="28"
                         VerticalContentAlignment="Center"
                         TextChanged="StepSizeText_OnTextChanged"/>
            </StackPanel>

            <Button Grid.Column="3"
                    x:Name="PatternScanOptionsButton"
                    Content="Scan Options"
                    Width="110"
                    Height="30"
                    Margin="8,18,8,0"
                    Click="PatternScanOptions_OnClick"/>

            <Button Grid.Column="4"
                    x:Name="StartScanButton"
                    Content="Start Scan"
                    Width="110"
                    Height="30"
                    Margin="0,18,8,0"
                    Click="StartScan_OnClick"/>

            <Button Grid.Column="5"
                    x:Name="CancelScanButton"
                    Content="Cancel"
                    Width="90"
                    Height="30"
                    Margin="0,18,0,0"
                    Click="CancelScan_OnClick"/>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="3*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,4,0"
                    Padding="10"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF3D3D3D"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Pattern Rules"
                                   Foreground="#FFF0F0F0"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="GeneralRulesButton" Width="110" Height="28" Margin="0,0,8,0" Content="General Rules" Click="GeneralRules_OnClick"/>
                            <Button Width="90" Height="28" Margin="0,0,8,0" Content="Add Rule" Click="AddRule_OnClick"/>
                            <Button Width="110" Height="28" Content="Remove Rule" Click="RemoveRule_OnClick"/>
                        </StackPanel>
                    </Grid>

                    <DataGrid x:Name="RuleGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Background="#FF242424"
                              Foreground="#FFF0F0F0"
                              RowBackground="#FF242424"
                              AlternatingRowBackground="#FF292929"
                              BorderThickness="0">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Relative Step" Binding="{Binding RelativeStep, UpdateSourceTrigger=PropertyChanged}" Width="1.1*"/>
                            <DataGridTemplateColumn Header="Type" Width="1.1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DataType}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.DataTypeChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding DataType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Condition" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ComparisonLabel}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding DataContext.RuleComparisonChoices, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding ComparisonOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Label"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                            <DataGridTextColumn Header="Value To" Binding="{Binding ValueToText, UpdateSourceTrigger=PropertyChanged}" Width="1.3*"/>
                            <DataGridTextColumn Header="Effective Offset" Binding="{Binding EffectiveOffsetText}" Width="1.2*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#FF4A4A4A"
                          ShowsPreview="True"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <Border Grid.Column="2"
                    Margin="4,0,0,0"
                    Padding="10"
                    Background="#FF2B2B2B"
                    BorderBrush="#FF3D3D3D"
                    BorderThickness="1"
                    CornerRadius="4">
                <DataGrid x:Name="ResultGrid"
                          AutoGenerateColumns="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.ScrollChanged="ResultGrid_OnScrollChanged"
                          SelectionChanged="ResultGrid_OnSelectionChanged"
                          MouseDoubleClick="ResultGrid_OnMouseDoubleClick"
                          Background="#FF242424"
                          Foreground="#FFF0F0F0"
                          RowBackground="#FF242424"
                          AlternatingRowBackground="#FF292929"
                          BorderThickness="0">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Foreground" Value="Black"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress}" Width="2.0*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProcessBaseDisplay}" Value="True">
                                            <Setter Property="Foreground" Value="#FF4CD964"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="1.1*"/>
                        <DataGridTextColumn Header="Raw Address" Binding="{Binding AddressHex}" Width="1.4*"/>
                        <DataGridTextColumn Header="Pattern Preview" Binding="{Binding PreviewText}" Width="2.8*"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                <ProgressBar x:Name="PatternProgressBar" Width="260" Height="20" Minimum="0" Maximum="100" Value="0"/>
                <TextBlock x:Name="PatternProgressText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FFE6E6E6" Text="Idle"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="TakeSelectedButton" Content="Take Selected" Width="120" Height="30" Margin="0,0,8,0" Click="TakeSelected_OnClick"/>
                <Button x:Name="TakeAllButton" Content="Take All" Width="100" Height="30" Click="TakeAll_OnClick"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
