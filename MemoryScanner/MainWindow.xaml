<Window x:Class="MemoryScanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MemoryScanner" Height="760" Width="1320" MinHeight="620" MinWidth="1080">
    <Grid Background="#FF1E1E1E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Background="#FF2B2B2B">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="Black"/>
                </Style>
                <Style x:Key="TopLevelMenuItemStyle" TargetType="{x:Type MenuItem}" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Setter Property="Foreground" Value="#FFF0F0F0"/>
                </Style>
            </Menu.Resources>
            <MenuItem Header="_File" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="_Load..." Click="MenuLoadWatchList_OnClick"/>
                <Separator/>
                <MenuItem Header="_Save" Click="MenuSaveWatchList_OnClick"/>
                <MenuItem Header="Save _As..." Click="MenuSaveWatchListAs_OnClick"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="MenuExit_OnClick"/>
            </MenuItem>
            <MenuItem Header="_Options" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="Scan Options..." Click="ScanOptions_OnClick"/>
                <MenuItem Header="Value Update Routine..." Click="ValueUpdateRoutine_OnClick"/>
            </MenuItem>
            <MenuItem Header="_Tools" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="Pointer Scanner" Click="OpenPointerScanner_OnClick"/>
            </MenuItem>
            <MenuItem Header="_Help" Style="{StaticResource TopLevelMenuItemStyle}">
                <MenuItem Header="About MemoryScanner" Click="MenuAbout_OnClick"/>
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Margin="8" Padding="10" Background="#FF2B2B2B" BorderBrush="#FF3D3D3D" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Select Process" Width="150" Height="30" Margin="0,0,8,0" Click="SelectProcess_OnClick"/>
                    </Grid>

                    <TextBlock x:Name="ProcessInfoText"
                               Grid.Row="1"
                               Margin="0,0,0,8"
                               Foreground="#FFE6E6E6"
                               Text="No process selected"/>

                    <DataGrid x:Name="WatchGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              SelectionMode="Single"
                              CanUserAddRows="False"
                              AllowDrop="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              HeadersVisibility="Column"
                              Background="#FF242424"
                              Foreground="#FFF0F0F0"
                              RowBackground="#FF242424"
                              AlternatingRowBackground="#FF292929"
                              BorderThickness="0"
                              ScrollViewer.ScrollChanged="WatchGrid_OnScrollChanged"
                              PreviewMouseLeftButtonDown="WatchGrid_OnPreviewMouseLeftButtonDown"
                              MouseMove="WatchGrid_OnMouseMove"
                              DragOver="WatchGrid_OnDragOver"
                              Drop="WatchGrid_OnDrop"
                              MouseDoubleClick="WatchGrid_OnMouseDoubleClick">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                        <Setter Property="Foreground" Value="#FFFF7A7A"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit Name..." Click="EditWatchName_OnClick"/>
                                <MenuItem Header="Edit Address/Pointer..." Click="EditWatchAddressPointer_OnClick"/>
                                <MenuItem Header="Edit Data Type..." Click="EditWatchDataType_OnClick"/>
                                <MenuItem Header="Write Value..." Click="WriteValueFromContext_OnClick"/>
                                <MenuItem Header="Copy Address" Click="CopyWatchAddress_OnClick"/>
                                <Separator/>
                                <MenuItem Header="Pointer-scan for this address" Click="PointerScanForSelected_OnClick"/>
                                <MenuItem Header="Repair Pointer Base..." Click="RepairPointerBaseFromWatch_OnClick"/>
                                <MenuItem Header="Show Nearby Addresses" Click="ShowNearbyAddressesFromWatch_OnClick"/>
                                <MenuItem Header="Open Memory Viewer" Click="OpenMemoryViewerFromWatch_OnClick"/>
                                <MenuItem Header="Find out what writes/accesses this address" Click="FindWriteAccessFromWatch_OnClick"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn x:Name="WatchNameColumn" Header="Name" Binding="{Binding Name}" Width="1.2*" IsReadOnly="True"/>
                            <DataGridTextColumn x:Name="WatchAddressColumn" Header="Address / Pointer" Binding="{Binding DisplayAddress}" Width="2.8*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProcessBaseDisplay}" Value="True">
                                                <Setter Property="Foreground" Value="#FF4CD964"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Invalid">
                                                <Setter Property="Foreground" Value="#FFFF7A7A"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn x:Name="WatchTypeColumn" Header="Type" Binding="{Binding DataType}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn x:Name="WatchValueColumn" Header="Value" Binding="{Binding LastValueText}" Width="*" IsReadOnly="True"/>
                            <DataGridCheckBoxColumn Header="Freeze" Binding="{Binding IsFrozen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Width="42" Height="30" Margin="0,0,8,0" Click="AddWatchEntry_OnClick" ToolTip="Add Entry">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE710;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Width="42" Height="30" Click="RemoveWatchEntry_OnClick" ToolTip="Remove Entry">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE74D;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1"
                                Width="130"
                                Height="30"
                                HorizontalAlignment="Right"
                                Content="Copy List Format..."
                                Click="CopyWatchListFormat_OnClick"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Margin="8" Padding="10" Background="#FF2B2B2B" BorderBrush="#FF3D3D3D" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Memory Scan" FontSize="20" FontWeight="SemiBold" Foreground="#FFF0F0F0" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="Data Type" Foreground="#FFE6E6E6"/>
                            <ComboBox x:Name="ScanTypeBox" Margin="0,4,0,0" Height="28"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Condition" Foreground="#FFE6E6E6"/>
                            <ComboBox x:Name="ScanComparisonBox" Margin="0,4,0,0" Height="28" SelectionChanged="ScanComparisonBox_OnSelectionChanged"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,8,0">
                            <TextBlock x:Name="ScanValueLabelText" Text="Value" Foreground="#FFE6E6E6"/>
                            <TextBox x:Name="ScanValueText" Margin="0,4,0,0" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel x:Name="ScanRangeToPanel" Grid.Column="3" Margin="0,0,8,0" Visibility="Collapsed">
                            <TextBlock Text="Range To" Foreground="#FFE6E6E6"/>
                            <TextBox x:Name="ScanValueToText" Margin="0,4,0,0" Height="28" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,18,8,0" x:Name="ScanButtonsPanel">
                            <Button x:Name="FirstScanButton" Width="42" Height="30" Margin="0,0,8,0" Click="FirstScan_OnClick" ToolTip="First Scan">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE768;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="NextScanButton" Width="42" Height="30" Margin="0,0,8,0" Click="NextScan_OnClick" ToolTip="Next Scan">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE72A;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="ResetScanButton" Width="42" Height="30" Click="ResetScan_OnClick" ToolTip="Reset Scan">
                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="15" Text="&#xE711;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="8,18,8,0" x:Name="CancelScanPanel" Visibility="Collapsed">
                            <Button x:Name="CancelScanButton" Content="Cancel Scan" Width="120" Height="30" Click="CancelScan_OnClick"/>
                        </StackPanel>

                        <Button Grid.Column="5" x:Name="ScanOptionsButton" Content="Scan Options" Width="110" Height="30" Margin="0,18,0,0" Click="ScanOptions_OnClick"/>
                    </Grid>

                    <DataGrid x:Name="ScanResultGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              SelectionMode="Extended"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.CanContentScroll="True"
                              Background="#FF242424"
                              Foreground="#FFF0F0F0"
                              RowBackground="#FF242424"
                              AlternatingRowBackground="#FF292929"
                              BorderThickness="0"
                              ScrollViewer.ScrollChanged="ScanResultGrid_OnScrollChanged"
                              MouseDoubleClick="ScanResultGrid_OnMouseDoubleClick"
                              SelectionChanged="ScanResultGrid_OnSelectionChanged"
                              PreviewMouseLeftButtonDown="ScanResultGrid_OnPreviewMouseLeftButtonDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Foreground" Value="Black"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Show Nearby Addresses" Click="ShowNearbyAddressesFromScanResult_OnClick"/>
                                <MenuItem Header="Open Memory Viewer" Click="OpenMemoryViewerFromScanResult_OnClick"/>
                                <MenuItem Header="Find out what writes/accesses this address" Click="FindWriteAccessFromScanResult_OnClick"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Address" Binding="{Binding DisplayAddress}" Width="2.4*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProcessBaseDisplay}" Value="True">
                                                <Setter Property="Foreground" Value="#FF4CD964"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="1.2*"/>
                            <DataGridTextColumn Header="Raw Address" Binding="{Binding AddressHex}" Width="1.6*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding DataType}" Width="*" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <ProgressBar x:Name="ScanProgressBar" Width="260" Height="20" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="ScanProgressText" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#FFE6E6E6" Text="Idle"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="TakeSelectedScanResultButton" Content="Take Selected" Width="120" Height="30" Margin="0,0,8,0" Click="TakeSelectedScanResult_OnClick"/>
                            <Button Content="Take All" Width="100" Height="30" Click="TakeAllScanResults_OnClick"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>














